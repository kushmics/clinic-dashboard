{
  "type": "object",
  "properties": {
    "case_summary": {
      "type": "object",
      "properties": {
        "patient_context": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": ["number", "integer", "null"] },
            "sex": { "type": "string" },
            "id": { "type": "string" }
          }
        },
        "clinical_text": { "type": "string" },
        "symptoms": { "type": "array", "items": { "type": "string" } },
        "lab_summary": { "type": "string" },
        "lab_observations": { "type": "array", "items": { "type": "string" } },
        "imaging_findings": { "type": "array", "items": { "type": "string" } },
        "context_gaps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "differentials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["low", "moderate", "high"] },
          "supporting": { "type": "array", "items": { "type": "string" } },
          "next_steps": {
            "type": "array",
            "description": "Actionable next steps, each with an Exa-backed citation when EXA_API_KEY is configured.",
            "items": {
              "type": "object",
              "properties": {
                "action": { "type": "string" },
                "citation": {
                  "type": ["object", "null"],
                  "properties": {
                    "title": { "type": "string" },
                    "url": { "type": "string" },
                    "snippet": { "type": ["string", "null"] },
                    "query": { "type": "string" },
                    "source": { "type": "string" }
                  },
                  "required": ["title", "url", "query", "source"]
                }
              },
              "required": ["action", "citation"]
            }
          }
        },
        "required": ["condition", "likelihood"]
      }
    },
    "red_flags": { "type": "array", "items": { "type": "string" } },
    "observations": { "type": "object" }
  },
  "required": ["differentials"]
}
