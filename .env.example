# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Prototype access gate for all API routes except /health.
# Use a non-default token for shared demos or pilots.
AUTH_ENABLED=true
AUTH_TOKEN=clinic-demo-token

# AI model layer (sponsor: OpenAI).
OPENAI_API_KEY=
# Reasoning/text model: triage, differentials, referral letters.
OPENAI_MODEL=gpt-5.4
# Chest X-ray vision reads run on their own model.
OPENAI_VISION_MODEL=gpt-4o-mini

EXA_API_KEY=

# Alternative provider — only if you swap off OpenAI. Leave blank otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Where uploaded labs/scans are stored locally (kept out of git).
UPLOAD_DIR=./data/uploads
