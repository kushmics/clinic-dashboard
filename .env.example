# Copy to .env and fill in. .env is gitignored.

# Prototype access gate for all API routes except /health.
# Use a non-default token for shared demos or pilots.
AUTH_ENABLED=true
AUTH_TOKEN=clinic-demo-token

# Needed only if you take an API-backed AI path for reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Where uploaded labs/scans are stored locally (kept out of git).
UPLOAD_DIR=./data/uploads
