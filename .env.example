# Copy to .env and fill in. .env is gitignored — never commit a real key.

# AI model layer (sponsor: OpenAI). Used ONLY for the extraction stage
# (photo/scan/PDF -> structured measurements). It never decides severity.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Cheaper alternatives for high-volume testing: gpt-5.4-mini, gpt-5.4-nano

# Alternative provider — only if you swap off OpenAI. Leave blank otherwise.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Where uploaded labs/scans are stored locally (kept out of git).
UPLOAD_DIR=./data/uploads
